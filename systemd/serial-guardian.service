[Unit]
Description=Serial Guardian - MicroPython session monitor + web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
# If nothing pings the watchdog for this long, systemd kills and restarts
# the process (Restart=always below still applies). Generous margin over
# the ~15s health-check interval in watchdog.py so normal slow operations
# (a soft-reset boot wait, a long GPS-sync session) never false-trigger it.
WatchdogSec=60
User=pi
WorkingDirectory=/home/pi/serial-guardian
ExecStart=/usr/bin/python3 /home/pi/serial-guardian/run.py
Restart=always
RestartSec=3
# 'dialout' for /dev/ttyACM0, 'gpio' only needed if ENABLE_GPIO_RESET is on
SupplementaryGroups=dialout gpio

[Install]
WantedBy=multi-user.target
